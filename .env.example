# Copy to ~/.config/opencode/.env (never commit) or export in your shell.
# The install scripts prompt for VAULT_PATH and write these for you.
# Windows (PowerShell):  $env:MEMORY_VAULT="D:\Notes\AgentMemory"
# Mac/Linux (bash):      export MEMORY_VAULT="$HOME/Notes/AgentMemory"

# Obsidian vault root (plain markdown folder). Used by memory-protocol skill,
# agent prompts (<VAULT_PATH> placeholder), and the orchestrator MCP server.
MEMORY_VAULT=<VAULT_PATH>

# Same vault path, as seen by the opencode-obsidian plugin (vaultPath in opencode.jsonc).
VAULT_PATH=<VAULT_PATH>

# opencode binary (default: opencode on PATH). Override if you use a custom path.
OPENCODE_BIN=opencode

# Obsidian desktop CLI.
# Windows: full path to Obsidian.exe, e.g. C:\Users\you\AppData\Local\Obsidian\Obsidian.exe
# Mac: usually just `obsidian` on PATH (or /Applications/Obsidian.app/Contents/MacOS/Obsidian).
# The Windows wrapper (mcp/obsidian-cli-wrapper.js) reads OBSIDIAN_EXE.
# The Mac shim (mcp/obsidian-cli.sh) execs `obsidian` by default.
OBSIDIAN_EXE=<OBSIDIAN_EXE>

# MiroFish (OPTIONAL). Only needed if you use command/mirofish.md + /research.
# Backend dir containing run.py, and base URL (default http://localhost:5001).
MIROFISH_BACKEND_DIR=<MIROFISH_DIR>/backend
MIROFISH_BASE_URL=http://localhost:5001
# Optional: where the auto-started backend logs go (default <MIROFISH_DIR>/backend/logs/backend.log).
# MIROFISH_BACKEND_LOG=<MIROFISH_DIR>/backend/logs/backend.log
